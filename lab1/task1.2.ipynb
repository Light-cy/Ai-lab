   "source": [
    "flavors = [\"vanilla\", \"chocolate\", \"strawberry\", \"pistacchio\"]\n",
    "sauces = [\"caramel\", \"butterscotch\", \"chocolate\"]\n",
    "count=0\n",
    "for i in range(len(flavors)):\n",
    "    for j in range(len(sauces)):\n",
    "        print(f\"{i} ice cream sundae with sauce {j}\")\n",
    "        count+=1\n",
    "print(count)"
   ]
  }
