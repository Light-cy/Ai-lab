graph={
    'S':['A','D','C'],
    'A':[],
    'B':['E'],
    'C':['F'],
    'D':['B','G'],
    'E':['G'],
    'F':['E','G'],
    'G':[]
}

queue=[]
visited=[]
def BFS(graphh,start):
    queue.append(start)
    while queue:
        node=queue.pop(0)
        
        for i in graphh[node]: # type: ignore
            if i in visited:
                continue
            visited.append(i)
            print(i,end=" ")
            queue.append(i)
        
print("BFS Traversal:")
BFS(graph,'S')
